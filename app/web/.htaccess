<IfModule mod_rewrite.c>
    RewriteEngine On

    # Serve real files and directories (static assets) as-is
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d

    # Everything else goes to the front controller with PATH_INFO
    RewriteRule ^(.*)$ index.php/$1 [QSA,L]
</IfModule>
